ATMOSPULSE_SOURCE=fixture
ATMOSPULSE_JETSTREAM_V1_URL=wss://jetstream2.us-west.bsky.network/subscribe
ATMOSPULSE_JETSTREAM_V2_URL=wss://jetstream.us-east.bsky.network/xrpc/network.bsky.jetstream.subscribeEvents
ATMOSPULSE_COLLECTIONS=app.bsky.feed.post,app.bsky.feed.like,app.bsky.feed.repost,app.bsky.graph.follow
ATMOSPULSE_KAFKA_BOOTSTRAP_SERVERS=localhost:19092
ATMOSPULSE_RAW_TOPIC=bluesky.raw.events
ATMOSPULSE_DLQ_TOPIC=bluesky.dlq
ATMOSPULSE_CURSOR_PATH=state/cursor.json
ATMOSPULSE_FIXTURE_PATH=tests/fixtures/jetstream_v2.jsonl
ATMOSPULSE_LOG_LEVEL=INFO
ATMOSPULSE_METRICS_PORT=9108
ATMOSPULSE_BRONZE_METRICS_PORT=9109
ATMOSPULSE_SPARK_METRICS_PORT=9110
ATMOSPULSE_BRONZE_BACKEND=local
ATMOSPULSE_BRONZE_ROOT=data/bronze
ATMOSPULSE_BRONZE_GCS_BUCKET=
ATMOSPULSE_BRONZE_BATCH_SIZE=10000
ATMOSPULSE_BRONZE_FLUSH_SECONDS=10
ATMOSPULSE_SILVER_ROOT=data/silver
ATMOSPULSE_SPARK_CHECKPOINT_ROOT=state/spark-checkpoints
ATMOSPULSE_SPARK_KAFKA_PACKAGE=org.apache.spark:spark-sql-kafka-0-10_2.13:4.0.4
ATMOSPULSE_SPARK_EXTRA_PACKAGES=
ATMOSPULSE_SPARK_MAX_OFFSETS_PER_TRIGGER=150000
ATMOSPULSE_SPARK_SHUFFLE_PARTITIONS=12
ATMOSPULSE_SPARK_ROCKSDB_MEMORY_MB=512
ATMOSPULSE_SPARK_STATE_STORE_PROVIDER=org.apache.spark.sql.execution.streaming.state.RocksDBStateStoreProvider
ATMOSPULSE_PYSPARK_SUBMIT_ARGS=--driver-memory 2g pyspark-shell
ATMOSPULSE_BQ_PROJECT=
ATMOSPULSE_BQ_LOCATION=US
ATMOSPULSE_BQ_STAGING_DATASET=atmospulse_staging
ATMOSPULSE_BQ_ANALYTICS_DATASET=atmospulse_analytics
ATMOSPULSE_BQ_MONITORING_DATASET=atmospulse_monitoring
ATMOSPULSE_BQ_METRICS_PORT=9111
ATMOSPULSE_DBT_TARGET=duckdb
ATMOSPULSE_DUCKDB_PATH=/tmp/atmospulse-dbt.duckdb
ATMOSPULSE_PUSHGATEWAY_URL=http://localhost:9091
ATMOSPULSE_BACKFILL_BRONZE_PATH=data/bronze/bluesky/event_date=*/event_hour=*/collection=*/*.jsonl.gz
AIRFLOW_DB_PASSWORD=
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
