# Copy this file to metrics.env. The real file is ignored by Git.
PROJECT_ID="replace-with-gcp-project"
RESOURCE_PREFIX="replace-with-globally-unique-lowercase-prefix"
ENVIRONMENT="dev"
GCP_REGION="us-west1"
BIGQUERY_LOCATION="US"
ALERT_EMAIL=""

# Increase this after a large Kafka run if Bronze needs longer to drain.
BRONZE_DRAIN_SECONDS="120"
BROKER_OUTAGE_SECONDS="10"
CONSUMER_OUTAGE_SECONDS="30"

# BigQuery comparison date range.
START_DATE="2026-01-01"
END_DATE="2026-01-02"

# Confirmations are intentionally not stored here. Supply them for one command only, for example:
# CONFIRM_TERRAFORM_APPLY=yes ./scripts/metrics/run.sh gcp-apply
